# HYPHA auto-hébergé : copier en .env, puis remplir. Ce fichier d'exemple ne contient aucun secret.
# Notice : https://hypha.s33d.fr/auto-hebergement/

# Version des images (registre-vm.s33d.fr/hypha/server et hypha/web). Mise à jour : changer la
# version, puis « docker compose pull && docker compose up -d ».
HYPHA_VERSION=0.13.0

# Mot de passe du compte PostgreSQL « hypha » (base du conteneur db). Exemple : openssl rand -hex 24
HYPHA_DB_PASSWORD=

# Adresse publique de l'interface, telle que la voient les navigateurs et les agents.
HYPHA_PUBLIC_URL=https://hypha.example.org
HYPHA_HTTPS_PORT=443

# Organisation et compte d'administration créés au premier démarrage.
HYPHA_ORG_NAME=Mon organisation
HYPHA_ADMIN_LOGIN=admin
HYPHA_ADMIN_PASSWORD=

# 64 caractères hexadécimaux, signe l'état de connexion OIDC : openssl rand -hex 32
HYPHA_SECRET=

# Connexion OIDC générique (facultatif ; seuls les comptes invités entrent).
HYPHA_OIDC_ISSUER=
HYPHA_OIDC_CLIENT_ID=
HYPHA_OIDC_CLIENT_SECRET=

# Notifications par e-mail (facultatif). HYPHA_SMTP_SECURITY : starttls | ssl | none
HYPHA_SMTP_HOST=
HYPHA_SMTP_PORT=587
HYPHA_SMTP_USER=
HYPHA_SMTP_PASSWORD=
HYPHA_SMTP_FROM=
HYPHA_SMTP_SECURITY=starttls

# Notifications push (facultatif) : clé VAPID du serveur, générée une fois par
#   docker compose exec api python -m hypha vapid-key   (puis « docker compose up -d »)
# La changer oblige chaque utilisateur à réactiver les notifications sur ses appareils.
# HYPHA_VAPID_SUBJECT : contact de l'exploitant pour les services de push (mailto: ou https:),
# HYPHA_PUBLIC_URL par défaut.
HYPHA_VAPID_PRIVATE_KEY=
HYPHA_VAPID_SUBJECT=

# Journal : DEBUG | INFO | WARNING | ERROR
HYPHA_LOG_LEVEL=INFO

# Traces du serveur lui-même (facultatif) : relais OTLP/HTTP d'un agent HYPHA, qui ajoute la clé.
# Vide = aucune trace. HYPHA_OTEL_SAMPLE : part des traces gardées, de 0 à 1.
HYPHA_OTEL_ENDPOINT=
HYPHA_OTEL_SAMPLE=0.2
