# Configuration de hypha-agent (contrat HYPHA § 5, compléments 0.4.0 : CONTRAT-04).
# Linux : /etc/hypha/hypha.yaml (droits 600). Windows : C:\ProgramData\Hypha\hypha.yaml.
# Vérifier après modification : hypha-agent check-config (affiche la conf fusionnée, secrets
# masqués, et le fichier d'origine de chaque erreur).
# Les variables d'environnement HYPHA_API_KEY et HYPHA_URL l'emportent sur ce fichier.
#
# Compléments : les fichiers conf.d/*.yaml du même dossier sont lus ensuite, dans l'ordre
# alphabétique, et fusionnés par clé (récursivement pour les objets ; une liste remplace la
# liste ; une clé absente garde sa valeur). Exemple : conf.d/10-parc.yaml posé par Ansible.
# Un fichier illisible ou invalide arrête l'agent : jamais de conf à moitié lue.

# Clé d'ingestion (Réglages → Clés API dans l'interface HYPHA). Obligatoire.
api_key: ""

# Serveur de collecte : hypha.s33d.fr, ou l'adresse du serveur auto-hébergé.
url: https://hypha.s33d.fr

# Nom de l'hôte dans HYPHA ; vide = nom système, en minuscules.
hostname: ""

# Étiquettes ajoutées à tout ce que l'agent envoie (clés : a-z 0-9 _ . - /).
tags: {}
#  env: prod
#  role: web

# Cadence des métriques et des contrôles.
interval: 15s

# Serveur auto-hébergé à certificat autosigné ou d'autorité interne : épingler la clé publique
# de son certificat (valeur affichée dans Réglages › Installer l'agent, variable HYPHA_TLS_PIN à
# l'installation). La clé reste vérifiée à chaque connexion ; plusieurs valeurs séparées par « ; ».
# tls_pin: "sha256//…"
# Couper toute vérification du certificat : à éviter, tls_pin fait la même chose sans le risque.
tls_skip_verify: false

# Mandataire HTTP pour joindre le serveur (vide = variables HTTPS_PROXY / NO_PROXY).
proxy: ""

# Tampon disque des envois en échec (serveur injoignable) : les plus anciens sont jetés
# au-delà de max_mb.
buffer:
  dir: /var/lib/hypha/buffer
  max_mb: 256

logs:
  enabled: true
  # Linux : journal systemd (journalctl), repris après le dernier envoi réussi.
  journald: true
  # Windows : journaux d'événements lus.
  windows_eventlog: [System, Application]
  # Fichiers suivis (motifs glob). Une ligne JSON est décodée : message/msg, level.
  files: []
  #  - {path: /var/log/nginx/*.log, service: nginx, source: nginx}
  # Lignes jamais envoyées (expressions régulières sur le message).
  exclude_patterns: []

# Instantané des processus (60 s) : les 30 premiers par CPU et par mémoire, plus ceux
# dont le nom ou la ligne de commande correspond à include (expressions régulières).
processes:
  enabled: true
  include: []

# Métriques réseau et instantané des connexions (60 s).
network:
  enabled: true
  # Interfaces ignorées (motifs glob). Valeur par défaut :
  # exclude_interfaces: [lo, "docker*", "veth*", "br-*", "virbr*", "cali*", "flannel*", "cni*", "Loopback Pseudo-Interface*"]

# Conteneurs Docker (30 s) : auto = si /var/run/docker.sock existe ; true ; false.
containers:
  enabled: auto

checks:
  # Unités systemd suivies. Les unités en échec sont TOUJOURS signalées, suivies ou non.
  systemd_units: []
  # Services Windows suivis. Un service à démarrage automatique arrêté est TOUJOURS signalé.
  windows_services: []
  # Services automatiques à ne pas signaler quand ils sont arrêtés : expressions régulières
  # (sans distinction de casse), en plus de la liste intégrée (services de mise à jour
  # Google et Edge, services sur déclencheur…). Exemple : ["^MonAppliMaj", "^Veeam"]
  windows_services_exclude: []
  # Signaler les services automatiques arrêtés : auto = oui sur Windows Server, non sur une
  # édition de poste de travail (les logiciels de constructeur y en laissent beaucoup) ;
  # always ; never.
  windows_auto_services: auto
  # Contrôles HTTP : statut attendu (200 par défaut), délai (5 s par défaut).
  http: []
  #  - {name: site, url: "https://exemple.fr/", expect_status: 200, timeout: 5s}
  # Contrôles TCP : ouverture du port (délai 3 s par défaut).
  tcp: []
  #  - {name: base, address: "192.0.2.20:5432", timeout: 3s}
  # Présence de processus : contrôle process.up (CRIT hors de [min, max]) et métrique
  # process.count. match : exact (nom, défaut), contains ou regex (nom ou ligne de commande).
  # min vaut 1 si ni min ni max ne sont donnés.
  processes: []
  #  - {name: nginx}
  #  - {name: gunicorn, match: contains, min: 2}
  #  - {name: "^php-fpm[0-9.]*$", match: regex, min: 1, max: 1}

# Intégrations : métriques des logiciels de l'hôte, noms compatibles Datadog, à chaque
# intervalle. L'état de chacune apparaît dans l'interface (Agents) : ok, absent, disabled,
# ou l'erreur rencontrée.
integrations:
  # PostgreSQL : auto = actif si la socket <socket_dir>/.s.PGSQL.<port> existe. Connexion
  # par cette socket en tant qu'utilisateur système « user » (authentification peer, sans
  # mot de passe, comme « sudo -u postgres psql »), ou par dsn s'il est renseigné
  # (exemple : postgres://hypha:motdepasse@127.0.0.1:5432/postgres?sslmode=disable ;
  # le rôle a besoin de pg_monitor). Session en lecture seule.
  # dbm : requêtes les plus coûteuses (toutes les 5 min, 50 premières par durée totale) si
  # l'extension pg_stat_statements existe dans la base postgres (auto), true, false.
  postgres:
    enabled: auto
    dsn: ""
    socket_dir: /var/run/postgresql
    port: 5432
    user: postgres
    dbm: auto
  # HAProxy : auto = actif si la socket d'administration existe (« show stat »), ou si url
  # est renseignée (page CSV des stats, par exemple http://127.0.0.1:8404/stats;csv).
  haproxy:
    enabled: auto
    socket: /run/haproxy/admin.sock
    url: ""
  # nginx : page stub_status (location /nginx_status { stub_status; allow 127.0.0.1; deny all; }).
  nginx:
    enabled: false
    url: http://127.0.0.1/nginx_status
  # Intégrations suivantes : auto = active après une première lecture réussie (logiciel
  # absent : état « absent », aucun contrôle, nouvel essai toutes les 10 min) ; true ; false.
  # Chacune publie <nom>.can_connect, ne casse jamais l'agent si l'outil manque.
  # Apache : page mod_status (?auto) ; apache.net.hits, .bytes_per_s, .performance.*, .conns_total.
  apache: {enabled: auto, url: "http://127.0.0.1/server-status?auto"}
  # BIND : canal de statistiques JSON (statistics-channels { inet 127.0.0.1 port 8053; };),
  # sinon « rndc status » (clients récursifs seuls).
  bind: {enabled: auto, url: "http://127.0.0.1:8053/json"}
  # Postfix : postqueue -j (files d'attente) ; remises (sent, deferred, bounced) comptées
  # dans les journaux collectés (journald ou mail.log).
  postfix: {enabled: auto}
  # Dovecot : doveadm stats dump (2.2 et 2.3) et doveadm who.
  dovecot: {enabled: auto}
  # OpenVPN : fichiers de statut (serveur : clients ; client : débit du tunnel). Un fichier
  # figé depuis 10 min passe openvpn.can_connect en CRIT.
  openvpn:
    enabled: auto
    status_files: ["/run/openvpn-server/status-*.log", "/run/openvpn/*.status", "/var/log/openvpn/*status*.log",
                   "/var/log/openvpn-status.log", "/etc/openvpn/*status*.log", "/etc/openvpn/server/*status*.log"]
  # fail2ban : fail2ban-client status (relu toutes les 5 minutes : l'outil est en Python).
  fail2ban: {enabled: auto}
  # Certificats posés sur l'hôte : tls.cert.days_left, contrôle tls.cert.expiry
  # (WARN sous 21 j, CRIT sous 7 j). Relus toutes les heures.
  x509:
    enabled: auto
    paths: ["/etc/letsencrypt/live/*/cert.pem", "/etc/ssl/*/fullchain.pem"]
  # SMART : smartctl (toutes les 30 min, sans réveiller un disque en veille).
  smart: {enabled: auto}
  # Capteurs du noyau (/sys/class/hwmon) : system.temperature, system.fan.rpm.
  hwmon: {enabled: auto}
  # Horloge : chronyc, timedatectl ou ntpq (Windows : w32tm) ; ntp.offset, contrôle ntp.in_sync.
  ntp: {enabled: auto}
  # VirtualBox : VM déclarées (VirtualBox.xml des comptes) et en marche (processus) ;
  # contrôle virtualbox.vm.running des VM en démarrage automatique. user : un seul compte.
  virtualbox: {enabled: auto, user: ""}
  # Timers systemd : contrôle systemd.timer (CRIT si le dernier passage a échoué, WARN si un
  # timer actif n'a pas tourné depuis deux périodes).
  systemd_timers: {enabled: auto}
  # Mises à jour en attente (sans « apt update » : liste du cache, relue toutes les heures) :
  # system.updates.pending, .security, system.reboot_required ; Windows : windows.updates.pending.
  updates: {enabled: auto}
  # Windows : IIS et SQL Server par compteurs de performance.
  iis: {enabled: auto}
  mssql: {enabled: auto}
  # Plusieurs cibles pour une même intégration (ovhcloud, mysql, redis, memcached, rabbitmq,
  # mongodb, opensearch, kubernetes, libvirt, proxmox, aws, scaleway, azure, gcp) : une liste
  # « instances », chacune nommée (name : minuscules, chiffres, - et _) et décodée sur les valeurs
  # par défaut de l'intégration, activée sauf « enabled: false ». Ses mesures, contrôles et
  # ressources portent l'étiquette instance_name. Les listes de plusieurs fichiers conf.d
  # s'additionnent : un fichier par compte ou par grappe. Exemple :
  # proxmox:
  #   instances:
  #     - name: grappe-b
  #       url: https://pve-b.exemple:8006
  #       token_id: hypha@pve!lecture
  #       token_secret: "…"

# Réception des métriques applicatives au format DogStatsD (UDP, boucle locale seulement).
statsd:
  enabled: true
  listen: 127.0.0.1:8125

# Relais OpenTelemetry (OTLP/HTTP) : les applications de l'hôte visent 127.0.0.1:4318,
# l'agent transmet au serveur en ajoutant la clé.
otlp:
  enabled: false
  listen: 127.0.0.1:4318

# --- 0.4.0 -----------------------------------------------------------------------------

# Canal de contrôle : l'agent interroge le serveur (aucun port ouvert sur l'hôte) pour les
# actions à distance, les tests synthétiques privés et la version cible.
control:
  enabled: true
  interval: 30s

# Mise à jour automatique vers la version cible fixée dans l'interface (Flotte). Les fichiers
# de <url>/install/ ne sont posés qu'après vérification de la signature ed25519 de
# SHA256SUMS (clé publique embarquée dans l'agent), de leur somme SHA-256, de leur version, et
# de la conf en place par la nouvelle version. Jamais en conteneur (mettre l'image à jour).
auto_update: false

# Actions à distance : gestes nommés, validés par un humain dans l'interface, exécutés ici
# seulement s'ils passent cette liste blanche (sinon refused_by_agent, avec le motif).
# Le service de l'agent n'est jamais touché, quelle que soit la liste.
actions:
  enabled: false
  # Gestes admis : restart_service, start_service, stop_service, run_script, update_agent.
  allow: [restart_service, start_service, stop_service]
  # Unités systemd ou services Windows admis (motifs) ; "*" = tous, sauf deny_services.
  services: ["*"]
  deny_services: ["sshd*", "ssh*", "hypha-agent*", "systemd-*"]
  # Scripts nommés (chemin absolu, propriétaire root, non modifiable par le groupe ou par
  # tous) : lancés sans argument, sortie bornée à 64 Kio. Sous l'unité systemd, /usr et /etc
  # restent en lecture seule pour eux (ProtectSystem).
  scripts: {}
  #  vider-cache-nginx: /etc/hypha/scripts/vider-cache-nginx.sh
  timeout: 120s

# Emplacement privé de tests synthétiques : les tests dont un emplacement est agent:<hôte>
# tournent depuis le réseau de cet hôte (adresses internes comprises).
synthetics:
  enabled: false
  max_concurrent: 4

# Inventaire matériel et logiciel (CMDB légère) : au démarrage puis à cet intervalle,
# envoyé seulement s'il a changé, et au moins une fois par jour.
inventory:
  enabled: true
  interval: 6h
  packages: true

# Équipements réseau interrogés en SNMP depuis cet hôte (switchs, box, NAS, imprimantes,
# onduleurs), publiés comme des hôtes à part entière. Les secrets SNMP restent ici : rien
# n'en part vers le serveur. profile : auto (d'après sysObjectID), generic, mikrotik,
# synology, printer, ups. interface_down : seen (défaut : CRIT seulement pour une interface
# déjà vue en service ; un port libre reste OK) ou always.
snmp:
  enabled: true
  interval: 60s
  devices: []
  #  - {name: switch-01, address: 192.0.2.252, version: 2c, community: public, tags: {role: switch}}
  #  - {name: nas, address: 192.0.2.40, version: 3, user: hypha, auth_protocol: sha, auth_key: "…",
  #     priv_protocol: aes, priv_key: "…", level: authPriv, profile: auto}
  # Traps v1/v2c reçus : événements source=snmp, type=snmp_trap (60 par minute au plus).
  traps: {enabled: false, listen: "0.0.0.0:162", community: public}

# --- 0.5.0 : moteurs génériques ----------------------------------------------------------

# Lecteur OpenMetrics/Prometheus (dans « integrations: » ci-dessus) : une entrée par cible.
# profile : node_exporter, prometheus (port, chemin, métriques, renommages et étiquettes par
# défaut). Compteurs envoyés en débits par seconde, jauges telles quelles, histogrammes et
# résumés en .count, .sum, .avg et centiles (p50, p95, p99). labels : étiquettes gardées comme
# tags (liste blanche, « * » = toutes) ; les séries qui ne diffèrent que par une étiquette
# écartée sont additionnées. max_series : plafond de séries par instance (2000), au-delà
# séries écartées et avertissement. Les listes de plusieurs fichiers conf.d s'additionnent.
# integrations:
#   openmetrics:
#     - profile: node_exporter                  # http://127.0.0.1:9100/metrics
#     - name: monappli
#       url: https://appli.exemple:8443/metrics
#       interval: 30s
#       timeout: 10s
#       namespace: monappli
#       metrics: [http_requests_total, "job_*", "re:queue_(depth|age)_.*"]
#       exclude_metrics: ["go_*"]
#       rename: {http_requests_total: http.requests}
#       labels: [code, method]
#       bearer_token_file: /etc/hypha/monappli.token   # relu à chaque relevé
#       ca_file: /etc/hypha/ca-interne.pem
#       max_series: 2000
#
# Plugins Nagios, Monitoring Plugins ou Centreon (dans « integrations: ») : commandes lues dans
# CE fichier seulement (jamais envoyées par le serveur), qui doit appartenir à root et n'être
# modifiable ni par le groupe ni par les autres ; l'exécutable aussi. Lancement direct, sans
# shell ($, *, | restent des caractères ordinaires) ; un simple nom est cherché dans
# /usr/lib/nagios/plugins, /usr/lib/monitoring-plugins, /usr/lib/centreon/plugins…
# Code de sortie 0/1/2/3 → contrôle nagios.check OK/WARN/CRIT/UNKNOWN (étiquette nagios_check) ;
# données de performance → nagios.perfdata (étiquette perf_label) et .warn, .crit, .min, .max.
# integrations:
#   nagios:
#     - name: disque-racine
#       command: check_disk -w 20% -c 10% -p /
#       interval: 60s
#       timeout: 30s
#       user: nagios            # compte qui lance le plugin (facultatif, Linux)
#     - name: http-local
#       command: [check_http, -H, 127.0.0.1, -u, /sante]

# Réception syslog (UDP et TCP, RFC 3164 et 5424, trames octet-counting ou fin de ligne).
# Coupée par défaut. L'agent n'ouvre aucun pare-feu : à régler à part. Le port 80 est refusé.
# Les lignes reçues partent comme journaux (source syslog, étiquette syslog_host = nom ou
# adresse de l'émetteur, statut d'après la sévérité). parsers : modèle d'analyse appliqué par
# le serveur à certains émetteurs (attribut syslog.parser ; kv = paires clé=valeur).
syslog:
  enabled: false
  udp: 0.0.0.0:514
  tcp: 0.0.0.0:514
  allowed_sources: []          # adresses ou réseaux admis ; vide = tous
  max_connections: 64
  rate_limit: 2000             # lignes par seconde, au-delà jetées et comptées
  parsers: []
  #  - {match: 192.0.2.0/24, parser: kv}

# --- Vague 5 : IA et GPU ------------------------------------------------------------------

# Ollama (dans « integrations: ») : version, modèles installés et chargés, temps de réponse ;
# trois lectures par minute, jamais de génération. Auto sur 127.0.0.1:11434.
# GPU NVIDIA par nvidia-smi : coupée par défaut (auto = active si nvidia-smi est présent).
# vLLM, LiteLLM, TGI, llama.cpp et l'exportateur DCGM : profils du lecteur OpenMetrics
# (vllm, litellm, tgi, llamacpp, dcgm).
# integrations:
#   ollama:
#     url: http://127.0.0.1:11434
#     instances:
#       - {name: gpu-2, url: "http://192.0.2.12:11434"}
#   nvidia_gpu:
#     enabled: auto
#     processes: true          # processus de calcul et mémoire par programme
#   openmetrics:
#     - profile: vllm          # http://127.0.0.1:8000/metrics
#     - profile: litellm       # callbacks: ["prometheus"] dans la conf de LiteLLM
#       bearer_token_file: /etc/hypha/litellm.key
#     - profile: llamacpp      # llama-server --metrics
#     - profile: dcgm          # dcgm-exporter, http://127.0.0.1:9400/metrics

# --- Vague 3 : Windows ---------------------------------------------------------------------

# Journaux d'événements : un canal en texte, ou en objet avec ses filtres (logs: ci-dessus).
#   windows_eventlog:
#     - System
#     - {channel: Application, exclude_providers: [Microsoft-Windows-Security-SPP]}
#     - channel: Security
#       event_ids: [4625, 4740, "4720-4726"]   # ou plages ; levels: [audit_failure]…
#       service: securite-windows
# Active Directory (contrôleur de domaine) et DNS Microsoft : auto, journaux Directory Service,
# DFS Replication et DNS Server ajoutés d'office (logs: false pour les laisser).
# integrations:
#   active_directory: {enabled: auto}
#   windows_dns: {enabled: auto, exclude_zones: ["*.in-addr.arpa"]}
#   perf_counters:                  # noms anglais des compteurs, quelle que soit la langue
#     - name: sql-locks
#       namespace: sqlserver
#       counters:
#         - {path: '\SQLServer:Locks(_Total)\Lock Waits/sec', metric: locks.waits}
#         - {path: '\PhysicalDisk(*)\Avg. Disk sec/Read', instance_tag: disk, exclude_instances: [_Total]}
#   wmi:
#     - name: os
#       class: Win32_OperatingSystem
#       properties: [FreePhysicalMemory, NumberOfProcesses]

# --- Vague 3 : sondes dédiées (Linux) ------------------------------------------------------

# Chaque logiciel lu par son interface native ; auto = actif si le logiciel répond à son adresse
# habituelle, ou dès que son compte, sa clé ou son adresse sont posés. Instances (§ 50) permises
# pour les sondes de service. Détail : https://hypha.s33d.fr/docs/applications-et-services/
# integrations:
#   phpfpm: {address: 127.0.0.1:9000}            # sinon les sockets /run/php/php*-fpm.sock
#   varnish: {command: "varnishstat"}             # « docker exec varnish varnishstat »…
#   squid: {url: "http://127.0.0.1:3128"}
#   lighttpd: {url: "http://127.0.0.1:8080/server-status"}
#   gunicorn: {apps: []}                          # requêtes : --statsd-host 127.0.0.1:8125
#   supervisord: {socket: /run/supervisor.sock}   # ou url: http://127.0.0.1:9001/RPC2
#   pgbouncer: {dsn: "postgres://hypha:…@127.0.0.1:6432/pgbouncer"}
#   proxysql: {dsn: "stats:…@tcp(127.0.0.1:6032)/"}
#   clickhouse: {url: "http://127.0.0.1:8123", username: hypha, password: "…"}
#   couchdb: {url: "http://127.0.0.1:5984", username: admin, password: "…"}
#   couchbase: {url: "http://127.0.0.1:8091", username: hypha, password: "…"}
#   zookeeper: {address: "127.0.0.1:2181"}        # 4lw.commands.whitelist=mntr,ruok,srvr
#   ceph: {command: "ceph --id hypha"}            # auto : si /etc/ceph/ceph.conf existe
#   openldap: {url: "ldapi://%2Frun%2Fslapd%2Fldapi"}   # ou ldaps://…, bind_dn, password
#   powerdns: {url: "http://127.0.0.1:8081", api_key: "…"}
#   powerdns_recursor: {url: "http://127.0.0.1:8082", api_key: "…"}
#   keycloak: {url: "http://127.0.0.1:9000", admin_url: "http://127.0.0.1:8080", client_id: hypha, client_secret: "…"}
#   nexus: {url: "http://127.0.0.1:8081", username: hypha, password: "…"}
#   harbor: {url: "https://harbor.exemple", username: admin, password: "…"}
#   fluentd: {url: "http://127.0.0.1:24220"}      # <source> @type monitor_agent
#   wazuh: {url: "https://127.0.0.1:55000", username: hypha, password: "…", insecure: true}
#   suricata: {eve_file: /var/log/suricata/eve.json, stale_after: 5m}
#   btrfs: {enabled: auto}
#   nfs: {enabled: auto, timeout: 5s, mounts: []}  # server_stats : /proc/<pid>/net/rpc/nfsd
#   ssh:
#     targets:
#       - {name: bastion, address: "bastion.exemple:22", expect_banner: "^SSH-2.0-OpenSSH_"}

# --- Vague 2 : logiciels exposant Prometheus (profils du lecteur OpenMetrics) --------------

# Un profil par logiciel ; sans url, l'adresse par défaut du profil (127.0.0.1). Profils :
# consul, vault, etcd, coredns, traefik, envoy, kong, cockroachdb, scylla, pulsar, celery (Flower),
# n8n, temporal, gitlab, gitlab_sidekiq, gitaly, sonarqube, solr, wildfly, tomcat, kafka,
# activemq, cassandra (ces quatre par l'exportateur JMX Prometheus en javaagent), cert_manager,
# velero, argocd, argocd_repo_server, linkerd, keda. Réglages côté logiciel et règles JMX :
# https://hypha.s33d.fr/docs/logiciels-prometheus/
# integrations:
#   openmetrics:
#     - profile: consul        # telemetry { prometheus_retention_time = "60s" } côté Consul
#     - profile: vault         # https://127.0.0.1:8200, unauthenticated_metrics_access ou jeton
#       bearer_token_file: /etc/hypha/vault-metrics.token
#     - profile: traefik       # --metrics.prometheus=true
#     - profile: kafka         # -javaagent:jmx_prometheus_javaagent-1.7.0.jar=127.0.0.1:9405:kafka.yml
#     - profile: sonarqube
#       headers: {X-Sonar-Passcode: "…"}
#     - profile: cert_manager
#       url: http://cert-manager.cert-manager.svc:9402

# --- Vague 6 : CI, forges, registres et gestion ------------------------------------------------

# Jenkins (API JSON : compte Overall/Read, Job/Read, Agent/ExtendedRead et son jeton d'API),
# GitHub (connecteur en lecture seule ; sans jeton : dépôts publics, 60 requêtes par heure),
# Odoo 17+ (/web/health, version, processus), Zot par le profil zot du lecteur OpenMetrics.
# WSUS (Windows) est COUPÉ par défaut. Détail : https://hypha.s33d.fr/docs/ci-forges-et-gestion/
# integrations:
#   jenkins: {url: "http://127.0.0.1:8080", username: hypha, password: "jeton d'API", jobs: []}
#   github:
#     repositories: [mon-organisation/mon-depot]
#     token: "github_pat_…"          # jeton fin en lecture seule (Actions, Metadata, alertes)
#     # endpoint: https://api.<sous-domaine>.ghe.com
#   odoo: {url: "http://127.0.0.1:8069"}
#   openmetrics:
#     - profile: zot                 # extensions.metrics.enable: true dans config.json de Zot
#       url: http://127.0.0.1:5000/metrics
#   wsus: {enabled: false, stale_days: 30, sync_max_age: 48h}
# --- Vague 7 : applications auto-hébergées ---------------------------------------------------

# Sondes par l'API REST de chaque application (auto : Jellyfin et Syncthing à leur port habituel ;
# Nextcloud et Immich dès que leur url est posée), clés de préférence dans un fichier (api_key_file,
# relu à chaque relevé). Gitea/Forgejo, Synapse, Home Assistant et Mastodon par leurs profils
# OpenMetrics. Détail : https://hypha.s33d.fr/docs/applications-auto-hebergees/
# integrations:
#   nextcloud: {url: "https://cloud.exemple", token_file: /etc/hypha/nextcloud.token}  # jeton serverinfo
#   jellyfin: {url: "http://127.0.0.1:8096", api_key_file: /etc/hypha/jellyfin.key}
#   syncthing: {url: "http://127.0.0.1:8384", api_key_file: /etc/hypha/syncthing.key}
#   immich: {url: "http://127.0.0.1:2283", api_key_file: /etc/hypha/immich.key}   # server.storage, server.statistics, job.read
#   openmetrics:
#     - profile: gitea          # ou forgejo ; [metrics] ENABLED = true, TOKEN facultatif
#       bearer_token_file: /etc/hypha/gitea-metrics.token
#     - profile: synapse        # écouteur « type: metrics » sur 9000, enable_metrics: true
#     - profile: homeassistant  # prometheus: dans configuration.yaml, jeton longue durée
#       bearer_token_file: /etc/hypha/homeassistant.token
#       max_series: 5000
#     - {profile: mastodon, name: mastodon-web, url: "http://127.0.0.1:9394/metrics"}
#     - {profile: mastodon, name: mastodon-sidekiq, url: "http://127.0.0.1:9395/metrics"}
#     - profile: mastodon_streaming

# --- Vague 8 : réseau, stockage et sauvegardes auto-hébergés --------------------------------

# Pi-hole, AdGuard Home, Unbound, Caddy (API d'administration), Mosquitto, Proxmox Backup Server,
# Borg et restic ; Caddy et MinIO publient aussi leurs mesures Prometheus (profils caddy, minio,
# minio_bucket). Rien n'est jamais écrit dans ces logiciels ; Borg et restic tournent sans verrou.
# Détail : https://hypha.s33d.fr/docs/reseau-stockage-sauvegardes/
# integrations:
#   pihole: {url: "http://127.0.0.1", password: "…"}          # mot de passe d'application de Pi-hole 6
#   adguard: {url: "http://127.0.0.1:3000", username: admin, password: "…"}
#   unbound: {command: "unbound-control"}                      # remote-control : control-enable: yes
#   caddy: {url: "http://127.0.0.1:2019"}
#   mosquitto: {url: "mqtt://127.0.0.1:1883", username: hypha, password: "…"}   # ACL : topic read $SYS/#
#   proxmox_backup:
#     url: https://127.0.0.1:8007
#     token_id: "hypha@pbs!lecture"                            # rôle Audit sur /, utilisateur et jeton
#     token_secret: "…"
#     fingerprint: "…"                                         # proxmox-backup-manager cert info
#   borg:
#     repositories:
#       - {name: serveur, repository: "ssh://borg@sauvegarde.exemple/./depot", passphrase_file: /etc/hypha/borg.pass}
#   restic:
#     repositories:
#       - {name: nas, repository_file: /etc/hypha/restic.repo, password_file: /etc/hypha/restic.pass}
#   openmetrics:
#     - profile: caddy                                         # option globale metrics du Caddyfile
#     - profile: minio                                         # mc admin prometheus generate <alias>
#       bearer_token_file: /etc/hypha/minio.token
